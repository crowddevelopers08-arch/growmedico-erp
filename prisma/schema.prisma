generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  role          String         @default("EMPLOYEE")
  employeeId    String?        @unique
  employee      Employee?      @relation(fields: [employeeId], references: [id])
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  outgoingCalls Call[]         @relation("CallsMade")
  incomingCalls Call[]         @relation("CallsReceived")
  preferences   Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// One row per 1:1 call. This IS the call history — each record carries the full
// lifecycle (who, type, status, timings, duration), so a separate CallHistory
// table would only duplicate it. The history API reads from here.
model Call {
  id         String   @id @default(cuid())
  // Deterministic LiveKit room the two peers join. Also the signaling key.
  roomName   String   @unique
  callerId   String
  caller     User     @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("CallsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  // "voice" | "video"
  type       String   @default("voice")
  // ringing | accepted | rejected | missed | canceled | ended | busy | failed
  status     String   @default("ringing")
  startedAt  DateTime @default(now())
  acceptedAt DateTime?
  endedAt    DateTime?
  // Talk time in seconds (acceptedAt → endedAt). 0 for calls never answered.
  durationSec Int     @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Active-call lookups (busy check) and per-user history both hit these.
  @@index([callerId, status])
  @@index([receiverId, status])
  @@index([callerId, createdAt])
  @@index([receiverId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String   @default("")
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Employee {
  id               String          @id @default(cuid())
  name             String
  email            String          @unique
  phone            String
  avatar           String?
  initials         String
  department       String
  role             String
  status           String          @default("present")
  joinDate         String
  salary           Float
  address          String
  emergencyContact String
  emergencyContactName String @default("")
  dateOfBirth      String
  user             User?
  attendance       Attendance[]
  leaveRequests    LeaveRequest[]
  salaryRecords    SalaryRecord[]
  activities       Activity[]
  tasks            Task[]
  projectMembers   ProjectMember[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Attendance {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          String
  checkIn       String?
  checkOut      String?
  checkInPhoto  String?
  checkOutPhoto String?
  status        String
  workHours     Float    @default(0)
  overtime      Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, date])
}

model LeaveRequest {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type            String
  startDate       String
  endDate         String
  days            Int
  // Permission-type requests only: duration in hours, the running count of
  // permissions taken that month, and the resulting deduction.
  hours           Float?
  permissionIndex Int?
  penalty         String?
  reason          String
  status          String   @default("pending")
  appliedOn       String
  approvedBy      String?
  approvedOn      String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SalaryRecord {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      String
  year       Int
  baseSalary Float
  bonus      Float    @default(0)
  deductions Float    @default(0)
  overtime   Float    @default(0)
  netSalary  Float
  status     String   @default("pending")
  paidOn     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, month, year])
}

model Activity {
  id          String    @id @default(cuid())
  type        String
  action      String
  description String
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  createdAt   DateTime  @default(now())
}

model Task {
  id           String         @id @default(cuid())
  title        String
  description  String?
  projectId    String?
  project      ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedToId String
  assignedTo   Employee       @relation(fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedById String
  assignedByName   String?
  assignedByAvatar String?
  // Flow 1 (Admin -> Manager -> Employee): the delegating manager (Employee id).
  // Null for direct tasks. Survives the handoff so the manager stays accountable
  // after reassigning the task down to an employee.
  managerId    String?
  priority     String         @default("medium")
  // Stage and status are stored as names, not ids. They are unique per project
  // (see ProjectStage / ProjectAttribute), which keeps every existing row and
  // query working while the new models supply order, colour and semantics.
  status       String         @default("pending")
  stage        String         @default("Unstaged Tasks")
  tags         String[]       @default([])
  startDate     String?
  dueDate       String?
  // Time-allocation countdown: estimated working hours (10:00-19:00 IST,
  // Sundays excluded). The countdown runs from createdAt.
  estimatedHours Float?
  // Stopwatch. trackedSeconds is the banked total; timerStartedAt is set while
  // the timer runs and folded into trackedSeconds when it stops, so elapsed
  // time survives a reload.
  trackedSeconds Int          @default(0)
  timerStartedAt DateTime?
  reminderAt    DateTime?
  // iCal-style RRULE ("FREQ=WEEKLY;BYDAY=MO"). Null means the task is one-off.
  recurrenceRule String?
  // Per-project custom fields, keyed by field name.
  customFields  Json?
  parentTaskId  String?
  parentTask    Task?          @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks      Task[]         @relation("TaskSubtasks")
  orderIndex    Int            @default(0)
  collaborators String[]       @default([])
  attachments   Json?
  comments      TaskComment[]
  history       TaskHistory[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([projectId, stage])
  @@index([parentTaskId])
}

// Audit trail behind the task detail panel's History tab. One row per changed
// field so the panel can render "X moved status from A to B".
model TaskHistory {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String
  actorName String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model ClientProject {
  id          String          @id @default(cuid())
  clientName  String
  name        String
  description String?
  status      String          @default("open")
  priority    String          @default("medium")
  dueDate     String?
  startDate   String?
  createdById String
  // "public" = visible to the whole workspace, "private" = members only.
  visibility  String          @default("public")
  // Employee ids. Owner is accountable for the project; defaultAssignee
  // pre-fills the assignee on new tasks.
  ownerId           String?
  defaultAssigneeId String?
  tags        String[]        @default([])
  // Legacy ordered stage names. ProjectStage is the source of truth for order
  // and colour; this array is kept in sync so older queries keep working.
  stages      String[]        @default(["Unstaged Tasks"])
  projectStages ProjectStage[]
  attributes  ProjectAttribute[]
  tasks       Task[]
  members     ProjectMember[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([clientName, name])
}

// One ordered, coloured column of the delivery pipeline (Discovery, Planning,
// Design...). Tasks point at it by name via Task.stage.
model ProjectStage {
  id         String        @id @default(cuid())
  projectId  String
  project    ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  color      String        @default("#64748b")
  orderIndex Int           @default(0)
  createdAt  DateTime      @default(now())

  @@unique([projectId, name])
  @@index([projectId, orderIndex])
}

// The selectable option sets a project defines for itself. One table covers all
// six lists the create wizard collects: status/tag/priority at project scope and
// at task scope. Tasks and projects reference these by name.
model ProjectAttribute {
  id         String        @id @default(cuid())
  projectId  String
  project    ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // "project" | "task"
  scope      String
  // "status" | "tag" | "priority"
  kind       String
  name       String
  color      String        @default("#64748b")
  orderIndex Int           @default(0)
  // Marks a status that counts as done, so progress and the dashboard's
  // "completed" figure don't have to hardcode the word "completed".
  isTerminal Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@unique([projectId, scope, kind, name])
  @@index([projectId, scope, kind, orderIndex])
}

// A blueprint a new project can be built from. Bundles stages, attribute option
// sets and starter tasks, all cloned into real rows at creation time.
model ProjectTemplate {
  id          String              @id @default(cuid())
  name        String              @unique
  description String?
  category    String              @default("General")
  tag         String?
  coverImage  String?
  // Built-in templates ship with the app and can't be edited away by users.
  isBuiltIn   Boolean             @default(false)
  createdById String?
  stages      TemplateStage[]
  attributes  TemplateAttribute[]
  tasks       TemplateTask[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model TemplateStage {
  id         String          @id @default(cuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  color      String          @default("#64748b")
  orderIndex Int             @default(0)

  @@unique([templateId, name])
}

model TemplateAttribute {
  id         String          @id @default(cuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  scope      String
  kind       String
  name       String
  color      String          @default("#64748b")
  orderIndex Int             @default(0)
  isTerminal Boolean         @default(false)

  @@unique([templateId, scope, kind, name])
}

// Starter task. Carries no assignee or dates — those only exist once the task
// is cloned into a real project.
model TemplateTask {
  id          String          @id @default(cuid())
  templateId  String
  template    ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    String          @default("medium")
  stageName   String?
  statusName  String?
  estimatedHours Float?
  orderIndex  Int             @default(0)

  @@index([templateId, orderIndex])
}

model ProjectMember {
  id         String        @id @default(cuid())
  projectId  String
  project    ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([projectId, employeeId])
}

model TaskComment {
  id           String    @id @default(cuid())
  taskId       String
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  senderId     String
  senderName   String
  senderAvatar String?
  content      String    @default("")
  audioContent String?
  attachments  Json?
  mentions     String[]
  editedAt     DateTime?
  createdAt    DateTime  @default(now())
}

model Channel {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdById String
  // Who can see and post in a group channel. Empty means "open to everyone",
  // which is what channels created before membership existed fall back to.
  // Direct and group DMs keep their membership in the name/description meta.
  memberIds   String[]  @default([])
  messages    Message[]
  createdAt   DateTime  @default(now())
}

model Message {
  id           String    @id @default(cuid())
  channelId    String
  channel      Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId     String
  senderName   String
  senderAvatar String?
  content      String    @default("")
  audioContent String?
  attachments  Json?
  mentions     String[]
  readBy       String[]  @default([])
  editedAt     DateTime?
  createdAt    DateTime  @default(now())
}

model CompanySettings {
  id         String   @id @default("global")
  name       String   @default("")
  email      String   @default("")
  phone      String   @default("")
  address    String   @default("")
  website    String   @default("")
  timezone   String   @default("Asia/Kolkata")
  dateFormat String   @default("DD/MM/YYYY")
  currency   String   @default("INR")
  updatedAt  DateTime @updatedAt
}
